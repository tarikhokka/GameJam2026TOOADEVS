  m_Script: {fileID: 11500000, guid: ffa169d7b61bda445bf85f992ca361b7, type: 3}
  m_Name: Rifat
  m_EditorClassIdentifier: CivilJam.Core::CivilJam.Core.ClientSO
  Id: rifat
  DisplayName: "R\u0131fat Usta"
  Portrait: {fileID: 21300000, guid: db63c515f380ee346a7401fb31a3727a, type: 3}
  IsHonest: 1
  IsThug: 0
  BribeRange: {x: 0, y: 0}
  GreetingLines:
  - "Kolay gelsin hocam. Demirini de betonunu da kendim kontrol ettim, siz de bakın, içiniz rahat etsin."
  - "Hocam acele yok. Eksik görürseniz söyleyin, düzeltir gelirim."
  - "Otuz yıldır bu işi yaparım hocam. Yaptığım binada kendi torunum oturuyor."
  - "Eksik bir şey görürseniz söyleyin hocam, ben tamamlarım."
  - "Ben bu işi torunlarım da oturacakmış gibi yaparım hocam."
  - "Şimdi bakıyorum, bazıları nereden kısarım derdinde. Bende öyle iş yok hocam."
  - "Sabah şantiyeden geldim hocam, üstümün tozuna bakmayın."
  - "Hocam çayınızı içerken bir göz atın, acelem yok."
  BribeLines: []
  ApproveLines:
  - "Allah razı olsun hocam. Temeline kendim baktım, gönül rahatlığıyla yükselir."
  - "Sağ olun hocam. Bitince çaya beklerim, bir de siz görün."
  - "Eksiksiz çıkmasına sevindim hocam. Usta işi böyle olur."
  - "Eyvallah hocam. Yarın sabah ilk harcı ben karacağım."
  - "Sağ olun hocam. Bu bina benden de uzun yaşar inşallah."
  - "Teşekkürler hocam. Kalfalara söyleyeyim, işe başlasınlar."
  RejectLines:
  - "Haklısınız hocam, gözümden kaçmış. Düzeltip yeniden getiririm."
  - "Otuz yılda pek başıma gelmezdi... Peki hocam, eksiği tamamlarım."
  - "Kızamam size hocam. Siz bakmasanız kim bakacak?"
  - "Peki hocam. Yaşlandık galiba, göz eskisi gibi değil."
  - "Doğru yaptınız hocam. Yarım iş binaya yakışmaz."
  - "Üzüldüm ama haklısınız hocam. Eksikle bina yükselmez."
  BribeRefusedLines: []
  ReturnLines:
  - "Yine ben geldim hocam. Geçen sefer projemi {last}; bunu daha da dikkatli hazırladım."
  - "Hocam hatırlarsınız, geçen sefer {last}. Bu dosyayı da aynı titizlikle getirdim."
  - "Hocam merhaba. Geçen sefer {last}, unutmadım. Bu sefer daha da özenli çalıştım."
  - "Yine ben, Rıfat. Geçen sefer {last}; bu dosyaya iki kere baktım."
  - "Hocam, geçen sefer {last}. Ustalık bitmez, her seferinde bir şey öğreniyorum."
  Gift: {fileID: 11400000, guid: 6de7d4c48d4443e58f8c4e3ce8579fa8, type: 2}
  GiftChance: 0.3
  BribeRaiseOnReject: 0
