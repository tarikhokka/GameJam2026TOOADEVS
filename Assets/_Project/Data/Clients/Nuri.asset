  m_Script: {fileID: 11500000, guid: ffa169d7b61bda445bf85f992ca361b7, type: 3}
  m_Name: Nuri
  m_EditorClassIdentifier: CivilJam.Core::CivilJam.Core.ClientSO
  Id: nuri
  DisplayName: "Nuri G\xF6znuru"
  Portrait: {fileID: 21300000, guid: 9fce580512db9cd46b5e78c03447e3ea, type: 3}
  IsHonest: 0
  IsThug: 0
  BribeRange: {x: 1000, y: 2000}
  GreetingLines:
  - "Hocaaam! Sizi görmek ne güzel, maşallah yüzünüz nur gibi."
  - "Getirdiğim proje de en az siz kadar güzel hocam."
  - "Yeğenim sizi çok övdü hocam, dedim mutlaka uğrayayım."
  - "Vallahi siz bu şehre gelmiş en iyi mühendislerden birisiniz hocam!"
  - "Eşim de sizi çok soruyor hocam, bir akşam yemeğe bekleriz."
  - "Bu projeyi sizinle yapmak harika olur hocam! Bütün arkadaşlarım sizi çok seviyor."
  - "Hocaaam, şu ofis ne güzel olmuş, tam sizin gibi zarif!"
  - "Annemin duası var hocam, bu dosya da sizin elinizden geçsin dedim."
  BribeLines:
  - "Göz nuru olsun hocam, lafı mı olur."
  - "Bayram değil seyran değil, ama ben size bir hediye getirdim."
  - "Şimdi imza atarsanız zarf da sizin, hatır da sizin."
  - "Bu küçük bir jest hocam, çok da bir şey değil. Aileden bir hatıra gibi düşünün."
  - "Küçük bir kolaylık yaparsanız çok sevinirim. Yani... çay parası falan. Aramızda kalsın."
  ApproveLines:
  - "Maşallah hocam, imzanız da yüzünüz kadar güzel!"
  - "Allah sizi başımızdan eksik etmesin hocam."
  - "Yeğenime söyleyeceğim, hocamız yine yaptı diye."
  - "Hocam ben demiştim, siz bu şehrin incisisiniz!"
  - "Eşime hemen haber veriyorum, çok sevinecek hocam!"
  - "Göz nurum benim! Bu iyiliği unutmam."
  RejectLines:
  - "Aaa hocam, yüreğim cız etti."
  - "Olur mu böyle... Peki, hatırınız kalsın."
  - "Kırıldım ama küsmem hocam, yine gelirim."
  - "Hocam gönlüm kırıldı ama sizi yine de çok seviyorum."
  - "Peki, peki... Ben yine de size bir kutu baklava gönderirim."
  - "Ah hocam... Yeğenime ne diyeceğim şimdi?"
  BribeRefusedLines:
  - "Hocam zarfı beğenmediniz galiba. Bir dahakine daha dolgun getiririm."
  - "Göz nurumu geri çevirdiniz... Olsun, ben ısrarcı adamım."
  - "Az geldi demek. Anladım hocam, anladım."
  - "Hocam ayıp ettiniz, ben gönülden getirmiştim."
  - "Peki, zarfı alıyorum ama gönlüm sizde kaldı hocam."
  ReturnLines:
  - "Hocaaam! Geçen sefer {last} ama ben size hiç küsmedim."
  - "Yine ben, göz nurunuz! Geçen sefer {last}; bu sefer gönlünüzü hoş edeceğim."
  - "Hocaaam, özledim sizi! Geçen sefer {last}, ama ben hep buradayım."
  - "Yine ben hocam! Geçen sefer {last}; eşim bu sefer de selam söyledi."
  - "Göz nurum! Geçen sefer {last}. Bugün çok güzel şeyler olacak, hissediyorum."
  Gift: {fileID: 11400000, guid: e06d46fc42ac45adb4ffde12026447ae, type: 2}
  GiftChance: 0.3
  BribeRaiseOnReject: 250
