  m_Script: {fileID: 11500000, guid: ffa169d7b61bda445bf85f992ca361b7, type: 3}
  m_Name: Selim
  m_EditorClassIdentifier: CivilJam.Core::CivilJam.Core.ClientSO
  Id: selim
  DisplayName: "Selim K\xE2\u011F\u0131t\xE7\u0131o\u011Flu"
  Portrait: {fileID: 21300000, guid: 8e50244066204e044a9f3ac2cc725647, type: 3}
  IsHonest: 0
  IsThug: 0
  BribeRange: {x: 0, y: 0}
  GreetingLines:
  - "İyi günler hocam. Bütün evraklar eksiksiz, laboratuvar raporu da taze."
  - "Kaşesi de imzası da yerinde hocam, buyurun inceleyin."
  - "Ek teste gerek yok hocam, raporlar her şeyi söylüyor zaten."
  - "Merak etmeyin hocam, her şey tam. Testlere gerek yok."
  - "Zaten hepsini düşündük hocam. Bu projede sıkıntı çıkmaz, emin olun."
  - "Bakın, burada her şey var: hesaplar, raporlar, imzalar. Eksik bir şey olamaz."
  - "Siz hiç merak etmeyin hocam, biz bu işleri iyi biliriz."
  - "Güzel bir gün, değil mi hocam? Dosya da gün gibi temiz."
  BribeLines: []
  ApproveLines:
  - "Teşekkürler hocam. Evrak dediğin böyle olur."
  - "Bilirdim. Kaşesi, imzası, hepsi yerinde."
  - "İyi çalışmalar hocam. Arşivinize düzgün bir dosya daha kattık."
  - "Söylemiştim hocam, her şey tam."
  - "Sizinle çalışmak keyif hocam. Kâğıttan anlıyorsunuz."
  - "Mükemmel. Bir sonraki dosyayı da aynı özenle getiririm."
  RejectLines:
  - "Hangi belgede sorun gördünüz hocam? Ben göremedim."
  - "İlginç... Laboratuvara bir daha soracağım."
  - "Peki hocam. Kâğıtlar tamamdı ama siz bilirsiniz."
  - "Hocam imzaları kendim kontrol etmiştim ama... Peki."
  - "Laboratuvar bir şeyi karıştırmış olmalı. Ben ilgilenirim."
  - "Garip... Kâğıtlar hiç yalan söylemez ama siz bilirsiniz hocam."
  BribeRefusedLines: []
  ReturnLines:
  - "İyi günler hocam. Geçen sefer {last}; bu dosya ondan da düzgün."
  - "Yine ben hocam. Geçen sefer {last}. Evraklar her zamanki gibi eksiksiz."
  - "Hocam iyi günler. Geçen sefer {last}; bu dosyada kaşeler de imzalar da yerinde."
  - "Yine ben, Selim. Geçen sefer {last}. Bugün testlere gerek kalmayacak."
  - "Merhaba hocam! Geçen sefer {last}, ama bu sefer her şey kâğıt üstünde kusursuz."
  Gift: {fileID: 11400000, guid: 54db3a1fbe7549bda784785ab1720f91, type: 2}
  GiftChance: 0.3
  BribeRaiseOnReject: 0
