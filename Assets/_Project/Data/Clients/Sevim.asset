  m_Script: {fileID: 11500000, guid: ffa169d7b61bda445bf85f992ca361b7, type: 3}
  m_Name: Sevim
  m_EditorClassIdentifier: CivilJam.Core::CivilJam.Core.ClientSO
  Id: sevim
  DisplayName: "Sevim Sa\u011Flamer"
  Portrait: {fileID: 21300000, guid: ef7883c3b5cab554f9a980b59b8cca33, type: 3}
  IsHonest: 1
  IsThug: 0
  BribeRange: {x: 0, y: 0}
  GreetingLines:
  - "Merhaba hocam. Laboratuvar raporları ekte, numuneleri de kendim teslim ettim."
  - "Biraz pahalıya çıktı ama içim rahat. Siz yine de inceleyin."
  - "Bu sefer okul yolunun üstünde hocam, ona göre sağlam yaptık."
  - "Bu projenin zemin etütlerini bizzat takip ettim hocam."
  - "Laboratuvar sonuçlarını da getirdim hocam, hepsini kontrol ettirdim."
  - "Maliyeti biraz yüksek oldu ama binayı sağlam yapmak her zaman daha doğru."
  - "Eksik bir evrak varsa söyleyin hocam, hemen tamamlarım."
  - "Günaydın hocam! Bu sefer bir oyun parkının yanındayız, ona göre çalıştık."
  BribeLines: []
  ApproveLines:
  - "Teşekkürler hocam. Raporların hepsini sakladım, ne zaman isterseniz bakarız."
  - "İçim rahat hocam. Çocuklar o sokaktan güvenle geçecek."
  - "Sağ olun. Bu işi sizin gibi yapan pek kalmadı."
  - "Harika! Şantiyeye hemen haber veriyorum."
  - "Teşekkürler hocam. Temel atma töreninde sizi de görmek isterim."
  - "Kurallara uyunca iş ne kadar rahat ilerliyor, değil mi hocam?"
  RejectLines:
  - "Anlıyorum hocam. Laboratuvarla tekrar konuşur, eksiği kapatırım."
  - "Bir yerde hata yapmışım demek. İyi ki yakaladınız."
  - "Peki hocam. Pahalıya patlayacak ama doğrusu bu."
  - "Haklısınız, bu benim de gözümden kaçmış. Hemen düzeltiyorum."
  - "Not aldım hocam. Bir dahaki dosya kusursuz olacak."
  - "Tamam hocam, tekrar ölçtüreceğim. Sağlam olsun da geç olsun."
  BribeRefusedLines: []
  ReturnLines:
  - "Merhaba yine hocam. Geçen sefer {last}; bu dosyada her satırı iki kez kontrol ettim."
  - "Hocam, geçen sefer {last}. Bu sefer de numuneleri kendim teslim ettim."
  - "Yine ben hocam! Geçen sefer {last}; bu dosyada notlarınızı da dikkate aldım."
  - "Hocam merhaba, geçen sefer {last}. Bu projeyi de baştan sona kendim takip ettim."
  - "Merhaba hocam! Geçen sefer {last}. Bugün de her şey kurallara uygun olsun istiyorum."
  MismatchLines:
  - "Doğru söylüyorsunuz. Laboratuvarla hemen konuşuyorum."
  - "Not aldım hocam. Bu benim hatam, düzelteceğim."
  - "İyi ki baktınız. Bu haliyle ben de imzalamazdım."
  BribeCloseLines: []
  Gift: {fileID: 11400000, guid: 76a240ceb7ec47559a0032ec513e2f1b, type: 2}
  GiftChance: 0.3
  BribeRaiseOnReject: 0
