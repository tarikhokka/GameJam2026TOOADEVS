  m_Script: {fileID: 11500000, guid: 080ef96a0a6a929468ab3076ef62920a, type: 3}
  m_Name: Dialogue
  m_EditorClassIdentifier: CivilJam.Core::CivilJam.Core.DialogueSO
  ParamBelowRule: "{param} {value} yaz\u0131yor; {group}l\u0131 binada en az {required} olmal\u0131."
  TestBelowRule: "Ek testte {param} {value} \xE7\u0131kt\u0131; {group}l\u0131 binada en az {required} olmal\u0131."
  ReportedVsTest: "Formda {param} {reported} yaz\u0131yor ama ek test {actual} g\xF6steriyor."
  FormVsLab: "Formda {param} {form}, laboratuvar raporunda {lab} yazıyor. Hangisi doğru?"
  ParcelMismatch: "Formdaki parsel {form}, raporda {lab} yaz\u0131yor."
  DateMismatch: Formun tarihi {form}, raporun tarihi {lab}.
  SignatureMismatch: "Formu {form} imzalam\u0131\u015F, raporu {lab}."
  LabNotAccredited: '{lab} akredite laboratuvarlar listesinde yok.'
  StampNotAccredited: "Ka\u015Fedeki {lab} akredite listede yok."
  BribeReactions:
  - Bu zarf ne?
  - "Bunu masama neden b\u0131rakt\u0131n\u0131z?"
  - Ne demek istiyorsunuz?
  - "Bu da neyin nesi?"
  GenericGreetingLines:
  - "Merhaba, yeni proje dosyasını getirdim."
  - "Kolay gelsin, başvuru için buraya yönlendirdiler."
  - "İyi günler, evrakları masanıza bırakıyorum."
  - "Merhaba, proje için inceleme sırası burası mı?"
  - "Kolay gelsin, dosyaya bakarken burada bekleyebilirim."
  - "İyi günler, başvuruyla ilgili belgeler burada."
  GenericApproveLines:
  - "Teşekkür ederim, onaylı dosyayı teslim alayım."
  - "Sağ olun, sıradaki işlemlere geçebilirim."
  - "Vaktinizi ayırdığınız için teşekkürler, kolay gelsin."
  - "Peki, onay işlemi tamamlandıysa evrakları alayım."
  - "Teşekkürler, şantiyeye haber vereyim."
  - "Hayırlı olsun, iyi çalışmalar."
  GenericRejectLines:
  - "Peki, dosyayı yeniden gözden geçireceğim."
  - "Beklediğim cevap bu değildi ama kararınızı anladım."
  - "Anlaşıldı, evrakları alıp döneyim."
  - "İş biraz uzayacak demek. Yine de kolay gelsin."
  - "Peki, eksikleri tamamlamadan ilerleyemeyeceğiz."
  - "Tamam, dosyayla yeniden ilgilenmem gerekecek."
  GenericMismatchLines:
  - "O kısmı bir daha gözden geçirmem gerekecek."
  - "Nasıl gözden kaçmış, ben de bir bakayım."
  - "Dosya hazırlanırken bir karışıklık olmuş olabilir."
  - "Söylediğiniz farkı şimdi fark ettim."
  - "Bir dakika, o bilgiyi kontrol etmem lazım."
  - "Anladım, bu kısmın açıklığa kavuşması gerekiyor."
  GenericBribeLines:
  - "Bu işi bugün onaylarsanız şu zarf da sizde kalsın."
  - "Aramızda bir kolaylık yapamaz mıyız? Zarfı buraya bırakayım."
  - "Dosya beklemesin diye ufak bir teşekkür hazırladım."
  - "Bir yolunu bulursanız masadaki zarfı da unutmuş olayım."
  - "Onay konusunda yardımcı olursanız bu zarf sizin."
  - "İşi uzatmadan halletsek? Zarfı masanıza bırakıyorum."
  GenericBribeCloseLines:
  - "Zarf burada dursun, karar sizin."
  - "Ne demek istediğimi anladınız. Cevabınızı bekleyeyim."
  - "Ben teklifimi yaptım, gerisi size kalmış."
  - "Nasıl uygun görürseniz, burada bekliyorum."
  - "Zarfı bıraktım, siz düşünün."
  - "Dosya da zarf da önünüzde, kararınızı bekliyorum."
  GenericBribeRefusedLines:
  - "Anladım, zarfı da dosyayı da geri alıyorum."
  - "Peki, teklifim de dosya da kabul görmedi."
  - "Siz bilirsiniz, zarfı geri alayım."
  - "Bu şekilde olmayacak demek. Evrakları alayım."
  - "Tamam, zarf bende kalsın. İyi günler."
  - "Kararınız kesin anlaşılan. Dosyayı yeniden hazırlayacağım."
