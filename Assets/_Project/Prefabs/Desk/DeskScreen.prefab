--- !u!114 &1455670184706742189
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6035514078476548544}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b3f846139fd4847489359928bec72a10, type: 3}
  m_Name: 
  m_EditorClassIdentifier: CivilJam.Desk::CivilJam.Desk.TutorialView
  panelRoot: {fileID: 14249631497351437}
  titleText: {fileID: 8823024009906632248}
  bodyText: {fileID: 749215572979585062}
  pageText: {fileID: 817952042653925782}
  nextButton: {fileID: 7057914383363023630}
  nextLabel: {fileID: 1551427113261571970}
  skipButton: {fileID: 6758396845039545338}
  titleFont: {fileID: 11400000, guid: 691a94f196862d74a90bd87be6d766c3, type: 2}
  bodyFont: {fileID: 11400000, guid: 8af5995d193981a4797d0ddd25143df8, type: 2}
  boldFont: {fileID: 11400000, guid: c9799eda0b436f047adcd5ded76fc33e, type: 2}
  cards:
  - Title: "Ulusal Yap\u0131 Denetim Kurumu'na ho\u015F geldin"
    Body: "M\xFCteahhitler s\u0131rayla gelip kar\u015F\u0131na oturacak. Senin imzan olmadan hi\xE7bir bina y\xFCkselmez.\n\n\xD6n\xFCndeki \xFC\xE7 belgeyi soldan sa\u011Fa kar\u015F\u0131la\u015Ft\u0131r: <b>YAPI DENET\u0130M FORMU</b>, <b>LABORATUVAR RAPORU</b> ve <b>DENET\xC7\u0130 EL K\u0130TABI</b>. Karar\u0131 formdaki <b>ONAY / RED</b> d\xFC\u011Fmeleriyle verirsin."
  - Title: "De\u011Ferleri kontrol et"
    Body: "Formdaki <b>KAT ADED\u0130</b>'ne bak: El Kitab\u0131'n\u0131n <b>HIZLI BAKI\u015E</b> sayfas\u0131 do\u011Fru kat grubunu kendisi g\xF6sterir.\n\nBeyan edilen her de\u011Fer ye\u015Fil alanda olmal\u0131. Tek bir k\u0131rm\u0131z\u0131 bile varsa bina reddedilir."
  - Title: Belgeler sahte olabilir
    Body: "Parsel, tarih ve m\xFCellif imzas\u0131 formda ve lab raporunda ayn\u0131 olmal\u0131. Ka\u015Fedeki laboratuvar El Kitab\u0131'n\u0131n <b>LAB</b> sekmesindeki akredite listede bulunmal\u0131.\n\nForm ile lab raporunda bir <b>de\u011Fer farkl\u0131</b> yaz\u0131yorsa ya yaz\u0131m hatas\u0131d\u0131r ya da biri yalan s\xF6yl\xFCyordur. Hangisi oldu\u011Funu lab raporundaki \xFCcretli <b>EK TEST</b> g\xF6sterir: ger\xE7ek de\u011Ferleri ortaya \xE7\u0131kar\u0131r."
  - Title: "\u0130mza senin"
    Body: "Bir uyu\u015Fmazl\u0131k buldu\u011Funda baz\u0131 m\xFCteahhitler masaya zarf b\u0131rak\u0131r. Almak da reddetmek de senin karar\u0131n.\n\nOnaylad\u0131\u011F\u0131n her bina bir g\xFCn afetle s\u0131nanacak. Kurallar\u0131 unutursan sa\u011Fdaki <b>EL K\u0130TABI</b>'na bak."
  - Title: "\u0130ncele ve kar\u015F\u0131la\u015Ft\u0131r"
    Body: "Masadaki <b>\u0130NCELE</b> d\xFC\u011Fmesine bas ve iki belgeden ayn\u0131 bilgiye t\u0131kla. Oyun sana <b>SORUN YOK</b>, <b>UYU\u015EMAZLIK SAPTANDI</b> ya da <b>ALAKASIZ</b> der.\n\nBir uyu\u015Fmazl\u0131k bulursan m\xFCteahhide s\xF6ylersin. \u0130nceleme \xFCcretsizdir; karar\u0131 yine sen verirsin."
  helpSprite: {fileID: 21300000, guid: 08e7519a07fd409b9d44fbfb36d58187, type: 3}
