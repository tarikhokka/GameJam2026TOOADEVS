MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6035514078476548544}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b3f846139fd4847489359928bec72a10, type: 3}
  m_Name: 
  m_EditorClassIdentifier: CivilJam.Desk::CivilJam.Desk.TutorialView
  panelRoot: {fileID: 14249631497351437}
  titleText: {fileID: 2602605458918327988}
  bodyText: {fileID: 3969537141617604537}
  pageText: {fileID: 817952042653925782}
  nextButton: {fileID: 7460680184787778154}
  nextLabel: {fileID: 5379754507450465308}
  skipButton: {fileID: 6758396845039545338}
  cards:
  - Title: "\u0130mar M\xFCd\xFCrl\xFC\u011F\xFC'ne ho\u015F geldin"
    Body: "Masana her g\xFCn yeni bina ba\u015Fvurular\u0131 gelecek. Senin imzan olmadan hi\xE7bir bina y\xFCkselmez.\n\nSoldaki listeden bir dosya se\xE7; her dosyay\u0131 onayla ya da reddet."
  - Title: "De\u011Ferleri kontrol et"
    Body: "Her dosyada iki belge var: <b>Ba\u015Fvuru</b> ve <b>Laboratuvar Raporu</b>.\n\nRapordaki beyan edilen her de\u011Fer y\xF6netmelikteki alt s\u0131n\u0131r\u0131 kar\u015F\u0131lamal\u0131. Kar\u015F\u0131lam\u0131yorsa bina y\xF6netmeli\u011Fe ayk\u0131r\u0131d\u0131r."
  - Title: Belgeler sahte olabilir
    Body: "Parsel, tarih ve imza iki belgede ayn\u0131 olmal\u0131. Ka\u015Fedeki laboratuvar, raporun ba\u015Fl\u0131\u011F\u0131ndakiyle ayn\u0131 olmal\u0131 ve akredite listede bulunmal\u0131.\n\nBeyana g\xFCvenmiyorsan \xFCcretli <b>ek test</b> iste: ger\xE7ek de\u011Ferleri g\xF6sterir."
  - Title: "\u0130mza senin"
    Body: "Baz\u0131 m\xFCteahhitler dosyan\u0131n aras\u0131na zarf koyar. Karar senin.\n\nOnaylad\u0131\u011F\u0131n her bina bir g\xFCn afetle s\u0131nanacak. Kurallar\u0131 unutursan sa\u011F \xFCstteki <b>El Kitab\u0131</b>'na bak."
