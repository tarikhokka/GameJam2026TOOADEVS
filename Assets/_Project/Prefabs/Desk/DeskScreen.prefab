  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b3f846139fd4847489359928bec72a10, type: 3}
  m_Name: 
  m_EditorClassIdentifier: CivilJam.Desk::CivilJam.Desk.TutorialView
  panelRoot: {fileID: 14249631497351437}
  titleText: {fileID: 8520130821256925001}
  bodyText: {fileID: 749215572979585062}
  pageText: {fileID: 817952042653925782}
  nextButton: {fileID: 7057914383363023630}
  nextLabel: {fileID: 2003285337836126058}
  skipButton: {fileID: 6758396845039545338}
  cards:
  - Title: "Ulusal Yap\u0131 Denetim Kurumu'na ho\u015F geldin"
    Body: "M\xFCteahhitler s\u0131rayla gelip kar\u015F\u0131na oturacak. Senin imzan olmadan hi\xE7bir bina y\xFCkselmez.\n\nM\xFCteahhit masaya ortadaki <b>YAPI DENET\u0130M FORMU</b>'nu ve soldaki mavi <b>LAB RAPORU</b>'nu b\u0131rak\u0131r. T\u0131klay\u0131nca a\xE7\u0131l\u0131rlar; ka\u011F\u0131tlar\u0131 s\xFCr\xFCkleyip yan yana koyabilirsin. Karar\u0131 formdaki <b>ONAY / RED</b> kutular\u0131yla verirsin."
  - Title: "De\u011Ferleri kontrol et"
    Body: "Formdaki kat say\u0131s\u0131na bak, sa\u011Fdaki ye\u015Fil <b>EL K\u0130TABI</b>'nda o kat grubunun en d\xFC\u015F\xFCk de\u011Ferlerini bul.\n\nBeyan edilen her de\u011Fer bu s\u0131n\u0131r\u0131 kar\u015F\u0131lamal\u0131. Tek bir de\u011Fer bile eksikse bina reddedilir."
  - Title: Belgeler sahte olabilir
    Body: "Parsel, tarih ve imza formda ve lab raporunda ayn\u0131 olmal\u0131. Ka\u015Fedeki laboratuvar, raporun ba\u015Fl\u0131\u011F\u0131ndakiyle ayn\u0131 olmal\u0131 ve akredite listede bulunmal\u0131.\n\nBeyana g\xFCvenmiyorsan lab raporundan \xFCcretli <b>ek test</b> iste: ger\xE7ek de\u011Ferleri g\xF6sterir."
  - Title: "\u0130mza senin"
    Body: "Baz\u0131 m\xFCteahhitler dosyan\u0131n aras\u0131na zarf koyar. Karar senin.\n\nOnaylad\u0131\u011F\u0131n her bina bir g\xFCn afetle s\u0131nanacak. Kurallar\u0131 unutursan masadaki ye\u015Fil <b>EL K\u0130TABI</b>'na bak."
