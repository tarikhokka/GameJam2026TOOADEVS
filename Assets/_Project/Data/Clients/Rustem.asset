  m_Script: {fileID: 11500000, guid: ffa169d7b61bda445bf85f992ca361b7, type: 3}
  m_Name: Rustem
  m_EditorClassIdentifier: CivilJam.Core::CivilJam.Core.ClientSO
  Id: rustem
  DisplayName: "Balyoz R\xFCstem"
  Portrait: {fileID: 21300000, guid: c313673d0ea7e824faf808a42c0995ef, type: 3}
  IsHonest: 0
  IsThug: 1
  BribeRange: {x: 1500, y: 2500}
  GreetingLines:
  - "Hocam selamünaleyküm. Ben uzatmayı sevmem."
  - "Projeyi getirdim. Siz de onaylayacaksınız, değil mi hocam?"
  - "Bu mahallede herkes beni tanır hocam. Siz de tanıyın istedim."
  - "Benim proje hazır hocam. Zaten bir sorun yok."
  - "Bu işleri fazla uzatmayalım hocam, herkesin zamanı kıymetli."
  - "Şunu halledelim hocam, sonrası kolay."
  - "Ofisin camları güzelmiş hocam. Temiz tutuyorsun."
  - "Oturayım hocam. Çay gelir mi?"
  BribeLines:
  - "Al hocam bunu. Ofisinizin camları çok güzel bu arada... Kırılsa yazık olur."
  - "İmza atarsın, zarfı alırsın. Atmazsan... neyse, sen atarsın."
  - "Ben iyilikten anlarım hocam. Kötülükten de anlarım."
  - "Bunu masaya bırakıyorum hocam. Ne demek istediğimi anladın."
  - "Zarf da burada, ben de buradayım hocam. Karar senin."
  ApproveLines:
  - "Gördün mü hocam, ne güzel anlaştık."
  - "Akıllı adamsın hocam. Camların da sağlam kalır."
  - "Bu iyiliği unutmam hocam."
  - "Anlaştık hocam. Böyle devam edelim."
  - "İyi iş hocam. Bunu duyan herkes memnun olur."
  - "Gördün mü, ne kolaymış."
  RejectLines:
  - "Yanlış yaptın hocam. Çok yanlış yaptın."
  - "Bu mahallede böyle iş olmaz hocam... Görürsün."
  - "Peki hocam. Akşama ofisin camlarına bir bak."
  - "Sen bilirsin hocam. Ben de bildiğimi yaparım."
  - "Bu iş burada bitmez hocam."
  - "Hm. Akşam geç saate kadar çalışıyor musun hocam?"
  BribeRefusedLines:
  - "Zarfımı geri mi itiyorsun? Bunu unutmam hocam."
  - "Sen bilirsin. Ben kibarca teklif ettim."
  - "Zarfı geri verdin, projeyi de geri verdin. İki hata hocam."
  - "Ben sana iyilik teklif ettim hocam. Sen istemedin."
  - "Peki hocam. Görüşürüz."
  ReturnLines:
  - "Yine ben hocam. Geçen sefer {last}; bunu ikimiz de hatırlıyoruz."
  - "Hocam, geçen sefer {last}. Bugün nasıl biteceği sana bağlı."
  - "Hocam yine geldim. Geçen sefer {last}, unutmadım."
  - "Selam hocam. Geçen sefer {last}. Bugün daha iyi anlaşırız."
  - "Ben yine buradayım hocam. Geçen sefer {last}; camlar hâlâ yerinde mi?"
  MismatchLines:
  - "Hocam bunu kurcalamasan iyi olur."
  - "Benim projemde sorun olmaz. Bir daha bak istersen."
  - "Hm. Bunu bulmak zorunda mıydın?"
  BribeCloseLines:
  - "Ne olduğunu biliyorsun hocam. Al ve imzala."
  - "Masada duruyor. Gerisi sana kalmış."
  - "Akıllı adam ne yapacağını bilir hocam."
  Gift: {fileID: 11400000, guid: a6d5a4293e1f4f91a314ca75459aa797, type: 2}
  GiftChance: 0.3
  BribeRaiseOnReject: 0
